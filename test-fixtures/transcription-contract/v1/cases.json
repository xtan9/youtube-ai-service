    {
      "id": "multilingual-language-tags",
      "endpoint": "/metadata",
      "request": {
        "youtube_url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
      },
      "languageTags": ["zh-Hans", "zh-Hant-TW", "en-US"],
      "service": {
        "arrange": {
          "kind": "metadata",
          "value": {
            "title": "多语言 fixture",
            "description": "Script and region tags stay deterministic.",
            "language": "zh-Hant-TW",
            "duration": 120,
            "subtitles": {
              "zh-Hans": [{ "url": "fixture", "ext": "vtt" }]
            },
            "automatic_captions": {
              "en-US": [{ "url": "fixture", "ext": "vtt" }]
            }
          }
        },
        "response": {
          "status": 200,
          "body": {
            "language": "zh",
            "title": "多语言 fixture",
            "description": "Script and region tags stay deterministic.",
            "duration": 120,
            "availableCaptions": ["zh", "en"]
          }
        }
      },
      "frontend": {
        "response": {
          "status": 200,
          "body": {
            "language": "zh",
            "title": "多语言 fixture",
            "description": "Script and region tags stay deterministic.",
            "duration": 120,
            "availableCaptions": ["zh", "en"]
          }
        },
        "expect": "success"
