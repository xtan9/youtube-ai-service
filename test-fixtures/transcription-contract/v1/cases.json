        "youtube_url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
      },
      "service": {
        "arrange": {
          "kind": "metadata",
          "value": {
            "title": "Contract fixture",
            "description": "A deterministic metadata fixture.",
            "language": "en",
            "duration": 893,
            "subtitles": {},
            "automatic_captions": {
              "en": [{ "url": "fixture", "ext": "vtt" }]
