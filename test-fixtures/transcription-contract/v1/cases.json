{
  "contractVersion": "transcription-http/v1",
  "owners": {
    "producer": "xtan9/youtube-ai-service",
    "consumer": "xtan9/youtubeai_chat_frontend"
  },
  "compatibilityWindow": {
    "current": "canonical-segments",
    "previous": "transcript-only",
    "policy": "Additive response fields only; the derived transcript alias remains until both deployments are verified.",
    "retirement": "Remove the alias in a separately reviewed cleanup change after the rollout window."
  },
  "youtubeUrl": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
  "cases": [
    {
      "id": "caption-success",
      "endpoint": "/captions",
      "request": {
        "youtube_url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
        "lang": "en"
      },
      "service": {
        "arrange": {
          "kind": "captions",
          "value": {
            "segments": [
              { "text": "Welcome to the lesson.", "start": 0, "duration": 2.5 },
              { "text": "Let's begin.", "start": 2.5, "duration": 1.5 }
            ],
            "source": "auto_captions",
            "language": "en",
            "title": "Contract fixture",
            "channelName": "Fixture Channel"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "segments": [
              { "text": "Welcome to the lesson.", "start": 0, "duration": 2.5 },
              { "text": "Let's begin.", "start": 2.5, "duration": 1.5 }
            ],
            "transcript": "Welcome to the lesson. Let's begin.",
            "source": "auto_captions",
            "language": "en",
            "title": "Contract fixture",
            "channelName": "Fixture Channel"
          }
        }
      },
      "frontend": {
        "response": {
          "status": 200,
          "body": {
            "segments": [
              { "text": "Welcome to the lesson.", "start": 0, "duration": 2.5 },
              { "text": "Let's begin.", "start": 2.5, "duration": 1.5 }
            ],
            "transcript": "Welcome to the lesson. Let's begin.",
            "source": "auto_captions",
            "language": "en",
            "title": "Contract fixture",
            "channelName": "Fixture Channel"
          }
        },
        "expect": "success"
      }
    },
    {
