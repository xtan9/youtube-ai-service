# Shared secret for Vercel <-> VPS auth
VPS_API_KEY=your-shared-secret-here

# Port (default 3001)
PORT=3001

# Primary hosted Whisper path
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=whisper-large-v3
GROQ_TIMEOUT_MS=120000

# Maximum audio duration eligible for local Whisper after a Groq failure
GROQ_LOCAL_FALLBACK_MAX_SECONDS=180

# Fail-closed resource and timeout limits for authenticated data endpoints.
MAX_REQUEST_BODY_BYTES=65536
MAX_MEDIA_SIZE_BYTES=50000000
MAX_MEDIA_DURATION_SECONDS=1800
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MAX_CONCURRENT_JOBS=2
METADATA_TIMEOUT_MS=30000
CAPTIONS_TIMEOUT_MS=30000
TRANSCRIBE_TIMEOUT_MS=300000

# Tailscale exit-node sidecar
TS_AUTHKEY=your-tailscale-auth-key
TS_EXIT_NODE_HOSTNAME=your-exit-node-hostname
